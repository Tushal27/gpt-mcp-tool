# Postgres connection string (Supabase's "Connection pooling" URI, Transaction
# mode, port 6543 recommended — matches this app's connect-per-request pattern).
DATABASE_URL=

# Shared secret remote clients must send in the X-Api-Token header.
MCP_AUTH_TOKEN=

# Optional: isolate tables under a non-default Postgres schema. Leave unset
# for normal use ("public"); tests override this automatically per run.
DB_SCHEMA=

# Voyage AI key for semantic memory search (voyageai.com -> API keys).
VOYAGE_API_KEY=

# Resend key for the daily digest email (resend.com -> API Keys).
RESEND_API_KEY=

# Where the daily digest email gets sent.
DIGEST_EMAIL_TO=
